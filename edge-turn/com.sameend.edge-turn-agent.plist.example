<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.sameend.edge-turn-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>set -a; . /private/etc/same-end/edge-turn-health.env; set +a; exec /opt/homebrew/bin/node /opt/same-end/edge-turn/agent.mjs --config /private/etc/same-end/edge-turn.json --serve</string>
  </array>
  <key>UserName</key>
  <string>turnagent</string>
  <key>GroupName</key>
  <string>turnagent</string>
  <key>WorkingDirectory</key>
  <string>/opt/same-end</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/same-end/edge-turn-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/same-end/edge-turn-agent.log</string>
</dict>
</plist>
