{
  "name": "same-end",
  "version": "0.3.2",
  "private": false,
  "description": "A private, delayed group viewing prototype for media you are allowed to share.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node serve.mjs",
    "build": "node build-pwa.mjs",
    "test": "node --test tests/backup-protocol.test.mjs tests/magnet-recovery.test.mjs tests/pwa-shell.test.mjs tests/media-player.test.mjs tests/source-audio.test.mjs tests/invite-report.test.mjs backend/test/control.test.mjs tests/fixture-feed.test.mjs tests/reader-core.test.mjs tests/reader-worker.test.mjs tests/legacy-browser.test.mjs",
    "test:social": "node tests/social-browser.test.mjs",
    "refresh:fixtures": "node scripts/update-fixtures.mjs",
    "build:vendor": "node scripts/build-vendor.mjs",
    "test:media": "node tests/media-playback-browser.test.mjs",
    "test:peers": "node tests/platform-peer-browser.test.mjs",
    "test:invites": "node tests/invite-check-browser.test.mjs",
    "test:legacy-apis": "node --test tests/legacy-api-browser.test.mjs",
    "test:host-reports": "node tests/host-reports-browser.test.mjs",
    "test:source-audio": "node tests/source-audio-browser.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://www.sameend.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezzye/same-end.git"
  },
  "bugs": {
    "url": "https://github.com/ezzye/same-end/issues"
  },
  "devDependencies": {
    "esbuild": "0.25.12"
  }
